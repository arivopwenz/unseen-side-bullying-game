  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Opening_Witness
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Narasi
    text: Taman sekolah, saat istirahat. Ari mengingat kejadian di halaman tadi pagi.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Minggu lalu, teman yang membela Denis juga diejek. Sejak itu aku memilih pura-pura tidak melihat.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Waktu kalian tertawa atau diam, aku merasa tidak ada yang akan percaya padaku.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Aku tidak tertawa, tetapi aku juga tidak mendekat. Aku takut kehilangan teman-temanku.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Kamu tidak perlu melawan kelompok itu sendirian. Menemani Denis dan mencari bantuan juga berarti bertindak.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Aku akan mendengarkan dulu. Lalu aku bisa meminta bantuan tanpa menyebarkan ceritanya ke semua orang.
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Ketakutan saksi dapat dipahami. Pilihan berikutnya tetap dapat mengurangi atau memperpanjang dampak perundungan.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
