  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Bully_Consent
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Billy
    text: Denis, aku ingin mengembalikan uang dan memperbaiki tindakanku. Apa kamu bersedia membahasnya dengan pendamping?
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Dengan Pak Bambang, iya. Jangan mendatangiku sendirian dan jangan menuntut aku memaafkanmu.
    voiceClip: {fileID: 0}
  - speakerName: Billy
    text: Aku akan menghormatinya. Aku tidak akan menghubungimu di luar cara yang kamu setujui.
    voiceClip: {fileID: 0}
