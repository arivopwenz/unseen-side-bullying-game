  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Teacher_Extortion
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Pak, Denis diancam dan diminta uang. Ia takut pembalasannya. Saya ingin tahu cara mendampingi tanpa membuatnya makin terpapar.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: Terima kasih menyampaikan fakta. Jangan hadapi kelompok itu sendiri. Saya akan mendekati Denis dengan hati-hati dan memeriksa keselamatannya.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Dia belum siap bercerita banyak.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: Kita beri ruang. Dukungan perlu berlanjut, bukan memaksa ia langsung merasa aman.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
