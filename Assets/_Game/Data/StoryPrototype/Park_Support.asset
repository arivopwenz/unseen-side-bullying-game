  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Park_Support
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Ini pesan yang berulang dan membuat saya takut. Saya ingin bantuan tanpa mempublikasikannya.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: Saya akan mendampingi penanganan. Simpan bukti, gunakan fitur lapor atau blokir bila aman, dan hubungi pendamping saat ancaman meningkat.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Saya ingin punya jalur laporan yang jelas kalau hal ini berulang.
    voiceClip: {fileID: 0}
