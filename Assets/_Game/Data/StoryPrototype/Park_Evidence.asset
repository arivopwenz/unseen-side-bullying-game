  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Park_Evidence
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Ari
    text: Pesan yang mengejekmu bisa disimpan sebagai bukti. Kita tidak perlu mengirim ulang ke grup.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Simpan untuk Pak Bambang saja. Aku tidak ingin orang lain melihat nama dan pesanku.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Baik. Kita catat waktu dan akun pengirim, lalu serahkan secara terbatas dengan persetujuanmu.
    voiceClip: {fileID: 0}
