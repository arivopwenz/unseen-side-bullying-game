  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dimas_Extortion
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Denis
    text: Mereka meminta uang jajanku lagi. Kalau aku menolak, mereka bilang akan menungguku setelah sekolah.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Itu ancaman, bukan kewajibanmu membayar.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku belum berani mengadu. Tolong jangan ceritakan ke semua orang.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku akan bertanya kepada Pak Bambang tentang pendampingan yang aman, dengan informasi seperlunya.
    voiceClip: {fileID: 0}
