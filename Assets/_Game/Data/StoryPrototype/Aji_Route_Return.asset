  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Aji_Route_Return
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Denis, aku tadi mengabaikanmu. Kalau kamu masih berkenan, aku ingin membantu dengan cara yang kamu anggap aman.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Bantu cari bukuku, ya. Jangan menyebarkan ceritaku.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku akan menghormati itu.
    voiceClip: {fileID: 0}
