  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Witness_Teacher
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Ari
    text: Saya melihat Billy meminta uang dan mengancam Denis. Saya sempat diam karena takut.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: Terima kasih menyampaikan fakta. Kamu boleh datang bersama pendamping; kamu tidak harus menghadapi Billy sendiri.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Saya ingin membantu tanpa menyebarkan nama dan cerita Denis ke grup kelas.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: Itu penting. Tanyakan persetujuannya sebelum membagikan informasi di luar penanganan ini.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
