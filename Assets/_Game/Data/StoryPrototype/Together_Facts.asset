  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Together_Facts
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Ari
    text: Aku ingin memeriksa catatanku sebelum memberi keterangan. Aku melihat pemalakan, tetapi tidak tahu semua percakapan sebelumnya.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Katakan bagian yang benar-benar kamu lihat. Jangan menambahkan rumor atau menyebarkan bukti pribadi.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Aku akan memisahkan fakta, hal yang belum kuketahui, dan kebutuhan pendampingan.
    voiceClip: {fileID: 0}
