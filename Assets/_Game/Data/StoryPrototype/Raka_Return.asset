  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Raka_Return
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Ini bukumu, Denis. Namamu ada di halaman pertama.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Terima kasih. Bukunya kembali, tetapi aku masih takut bertemu mereka.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku paham. Mengembalikan barang belum menyelesaikan ancaman. Kita bicara tentang langkah yang aman.
    voiceClip: {fileID: 0}
