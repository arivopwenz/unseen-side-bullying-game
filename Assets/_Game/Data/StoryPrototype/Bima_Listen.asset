  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Bima_Listen
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Bima
    text: Aku tertawa supaya tidak dibilang merusak suasana. Tapi Denis sudah berkali-kali meminta berhenti.
    voiceClip: {fileID: 0}
  - speakerName: Billy
    text: Jadi tawa kalian tidak berarti semua orang setuju?
    voiceClip: {fileID: 0}
  - speakerName: Bima
    text: Tidak. Aku ikut membuatnya terasa diterima. Aku juga harus berhenti mendukungnya.
    voiceClip: {fileID: 0}
  - speakerName: Billy
    text: Aku harus mendengar dampaknya, bukan mencari alasan dari reaksi kalian.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
