  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Bully_Plan
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Billy
    text: Denis hanya bersedia bicara dengan pendamping. Saya menyetujui batas itu.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: 'Langkah pertama: hentikan ancaman, kembalikan uang melalui pendamping, dan hentikan ejekan di kelompok.'
    voiceClip: {fileID: 0}
  - speakerName: Billy
    text: Saya akan menyampaikan batas itu kepada teman-teman dan datang untuk tindak lanjut.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: Saya akan memeriksa tindakanmu. Perubahan perlu bukti, bukan sekadar janji.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
