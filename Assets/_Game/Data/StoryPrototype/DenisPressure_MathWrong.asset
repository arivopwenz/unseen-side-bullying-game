  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: DenisPressure_MathWrong
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Denis
    text: Aku... kehilangan urutannya. Aku memilih jawaban yang keliru.
    voiceClip: {fileID: 0}
  - speakerName: Billy
    text: Soal begitu saja tidak bisa. Memalukan.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Semalam aku mencoba belajar. Sekarang pikiranku kosong karena takut mereka tertawa.
    voiceClip: {fileID: 0}
  - speakerName: Pak Bambang
    text: 'Hentikan ejekannya, Billy. Jawaban yang benar 50: perkalian lebih dulu, lalu tambah 8. Salah menjawab adalah bagian dari belajar.'
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Kesalahan hitung tidak membenarkan hinaan. Tekanan Denis belum hilang ketika pelajaran selesai.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
