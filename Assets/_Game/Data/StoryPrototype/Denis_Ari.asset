  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Denis_Ari
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Ari
    text: Denis, aku melihat mereka mengambil makananmu. Maaf aku tidak maju. Aku takut juga.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku belum siap mengadu. Jangan kirim cerita atau foto ke grup.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Aku tidak akan menyebarkannya. Aku bisa duduk di dekatmu dan menemani ketika kamu siap mencari pendamping.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Untuk sekarang, temani aku sebentar. Besok sekolah terasa menakutkan.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Aku tinggal di sini. Kita bisa mencari jalan yang lebih aman bersama.
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Kehadiran Ari adalah awal dukungan, bukan penyelesaian instan. Keberanian saksi dan penanganan sekolah perlu berkembang pada chapter berikutnya.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
