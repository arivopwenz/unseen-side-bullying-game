  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Opening_Boundaries
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Narasi
    text: Taman lingkungan, sepulang sekolah. Denis kembali merasakan tekanan dari ejekan berulang di grup.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku takut membuka pesan. Di kelas aku makin sulit fokus; aku merasa semua orang sedang membicarakanku.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Kesulitanmu bukan alasan mereka merendahkan. Aku ingin menemani dengan mengikuti batasmu.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku ingin menyimpan bukti, tapi jangan kirim ulang ke orang lain.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Aku dapat membantu menyimpan seperlunya. Kamu menentukan siapa boleh melihat.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku ingin Pak Bambang tahu, dengan seseorang di sampingku.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Kita susun langkahnya pelan-pelan. Kamu tidak harus menghadapi mereka sendiri.
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Dukungan yang berlanjut membantu Denis menetapkan batas; keselamatannya tetap menjadi tujuan.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
