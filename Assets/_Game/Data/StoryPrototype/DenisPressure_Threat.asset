  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: DenisPressure_Threat
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Billy
    text: Uangmu juga sini. Kalau kamu mengadu ke guru atau orang tua, kamu akan menyesal. Aku tunggu setelah sekolah.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku takut. Uang itu untuk pulang.
    voiceClip: {fileID: 0}
  - speakerName: Fajar
    text: Jangan cari masalah. Diam saja.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Kalau aku cerita, bagaimana kalau ancaman itu benar-benar terjadi? Aku belum sanggup menjelaskan.
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Ancaman membatasi rasa aman Denis. Tanggung jawab pemalakan tetap berada pada pelaku; Denis tidak harus melawan sendirian.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
