  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Witness_Check
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Ari
    text: Denis, aku melihat kejadian tadi. Aku menyesal pura-pura tidak melihat.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Aku tidak butuh kamu mempermalukan mereka di depan semua orang. Aku ingin didengar dan merasa aman.
    voiceClip: {fileID: 0}
  - speakerName: Ari
    text: Apa aku boleh menemanimu sekarang?
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Boleh. Terima kasih bertanya dulu.
    voiceClip: {fileID: 0}
