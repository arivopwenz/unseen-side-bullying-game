  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Raka_Request
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Denis
    text: Bukuku perlu untuk tugas besok. Aku kehilangan catatan saat sedang berusaha mengejar pelajaran yang tertinggal.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku membantu karena kamu membutuhkannya, bukan karena perintah Billy. Aku cari di halaman dulu.
    voiceClip: {fileID: 0}
  - speakerName: Denis
    text: Ada namaku di dalam. Bawa kembali kepadaku kalau sudah ketemu.
    voiceClip: {fileID: 0}
