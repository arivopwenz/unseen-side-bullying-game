  m_Name: Dialogue_GuruBK_Intro
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Guru BK
    text: Selamat Pagi, Nak. Ada yang bisa Bapak bantu?
  - speakerName: Guru BK
    text: Jika kamu melihat teman yang di-bully, jangan diam saja.
  - speakerName: Guru BK
    text: Laporkan ke guru atau orang dewasa terdekat, ya.
