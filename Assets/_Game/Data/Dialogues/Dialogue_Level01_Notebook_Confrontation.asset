  m_Name: Dialogue_Level01_Notebook_Confrontation
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Billy
    text: Mau membawa buku Denis? Kalian sekarang kompak, ya?
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Ini buku tugasnya. Kami ingin membawanya kembali.
    voiceClip: {fileID: 0}
  - speakerName: Fajar
    text: Coba tahan kalau memang berani.
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Kelompok Billy menghalangi Aji. QTE berikutnya menentukan apakah buku langsung diamankan atau perlu dicari lagi.
    voiceClip: {fileID: 0}
