  m_Name: Dialogue_M02_observe_raka
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Dion
    text: Serahkan buku jawaban PR-mu sekarang.
    voiceClip: {fileID: 0}
  - speakerName: Raka
    text: Ini...
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Raka berbicara pelan. Aji belum mengetahui kejadian sebelumnya.
    voiceClip: {fileID: 0}
  choiceId: M02/observe_raka
  responses:
  - label: Tidak mendukung tekanan; tanyakan kebutuhan Raka nanti.
    lines:
    - speakerName: Aji
      text: Aku belum tahu apakah Raka dapat menolak dengan aman.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Anggap Raka senang memberikan jawaban.
    lines:
    - speakerName: Narasi
      text: Penyerahan barang atau diam tidak membuktikan persetujuan bebas. Dengarkan konteksnya. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
