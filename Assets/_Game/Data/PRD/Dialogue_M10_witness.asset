  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M10_witness
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Sari
    text: Aku melihat Fajar membawa tas Raka menuju ruang guru sebelum pelajaran. Aku tidak mendengar semua percakapannya.
    voiceClip: {fileID: 0}
  choiceId: M10/witness
  responses:
  - label: Minta guru membantu dengan informasi yang ada.
    lines:
    - speakerName: Aji
      text: Catatan boleh belum lengkap. Kita tidak perlu mengikuti atau merekam siapa pun diam-diam.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Tambahkan ancaman yang tidak didengar.
    lines:
    - speakerName: Narasi
      text: Jangan menambahkan fakta yang tidak diketahui. Bantuan tidak mensyaratkan bukti lengkap. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
