  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M02_observe_bima
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Dion
    text: Bima, badanmu jadi bahan candaan kami.
    voiceClip: {fileID: 0}
  - speakerName: Tio
    text: Hahaha!
    voiceClip: {fileID: 0}
  - speakerName: Bima
    text: Hehe...
    voiceClip: {fileID: 0}
  - speakerName: Narasi
    text: Bima menjauh. Satu adegan belum menjelaskan apakah kejadian berulang.
    voiceClip: {fileID: 0}
  choiceId: M02/observe_bima
  responses:
  - label: Tidak ikut tertawa; perhatikan tanpa menyimpulkan semua hal.
    lines:
    - speakerName: Aji
      text: Aku melihat ejekan tubuh. Aku belum tahu perasaan Bima atau pengulangannya.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Ikut tertawa agar diterima kelompok.
    lines:
    - speakerName: Narasi
      text: Tawa saksi dapat menguatkan ejekan. Pilih sikap yang tidak mendukung tindakan merendahkan. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
