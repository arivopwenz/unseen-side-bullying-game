  lines:
  - speakerName: Narasi
    text: Saat PJOK, Dion kembali mengomentari tubuh Bima. Tio ikut tertawa.
    voiceClip: {fileID: 0}
  - speakerName: Dion
    text: Dengan badan begitu, kamu yakin bisa ikut permainan?
    voiceClip: {fileID: 0}
  - speakerName: Tio
    text: Hahaha!
    voiceClip: {fileID: 0}
  - speakerName: Bima
    text: Hehe... aku ke tepi lapangan dulu.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku akan menanyakan apakah ia bersedia bicara.
    voiceClip: {fileID: 0}
