MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M14_laras
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Bersedia cerita tentang kelompokmu?
    voiceClip: {fileID: 0}
  - speakerName: Laras
    text: Aku mendapat peran, tetapi takut ditolak lagi pada tugas berikutnya.
    voiceClip: {fileID: 0}
  choiceId: M14/laras
  responses:
  - label: Teruskan kebutuhan kepada Bu Ratih.
    lines:
    - speakerName: Bu Ratih
      text: Saya memeriksa pembagian kelompok berikutnya dan menindaklanjuti hasutan. Kita bicara privat tanpa memaksamu berteman dengan Dion.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Hormati pilihan Laras bicara sendiri kepada guru.
    lines:
    - speakerName: Laras
      text: Aku ingin bicara sendiri.
      voiceClip: {fileID: 0}
    - speakerName: Bu Ratih
      text: Saya siapkan pertemuan privat dan memantau kelompok berikutnya.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Minta memaafkan agar urusan selesai.
    lines:
    - speakerName: Narasi
      text: Memaafkan bukan syarat perlindungan. Akses belajar tetap tanggung jawab sekolah. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
