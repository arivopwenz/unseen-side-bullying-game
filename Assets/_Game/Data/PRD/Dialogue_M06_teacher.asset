MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M06_teacher
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Saya melihat Dion mengomentari tubuh Bima dan Tio tertawa. Bima mengatakan ini berulang dan tidak nyaman.
    voiceClip: {fileID: 0}
  - speakerName: Pak Beni
    text: Terima kasih membedakan pengamatan dan cerita. Dion dan Tio, hentikan komentar tubuh serta dukungan pada ejekan.
    voiceClip: {fileID: 0}
  - speakerName: Pak Beni
    text: Saya membagi tim adil dan memantau kegiatan. Bima tidak harus mengubah tubuh atau menang untuk mendapat perlindungan. Saya berkoordinasi dengan Pak Arif.
    voiceClip: {fileID: 0}
  choiceId: M06/teacher
  responses:
  - label: Dukung pilihan Bima ikut bermain.
    lines:
    - speakerName: Bima
      text: Aku ingin mencoba ikut tim.
      voiceClip: {fileID: 0}
    - speakerName: Pak Beni
      text: Saya tetap mengawasi. Beri tahu jika ada komentar lagi.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Dukung pilihan Bima beristirahat.
    lines:
    - speakerName: Bima
      text: Aku istirahat dulu.
      voiceClip: {fileID: 0}
    - speakerName: Pak Beni
      text: Baik. Tempatmu tetap tersedia dan saya mengecek keadaanmu.
      voiceClip: {fileID: 0}
    retryChoices: 0
  contextChoiceId: 
  contextResponses: []
