MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M12_route
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Sari
    text: Pilih koridor biasa, jalur samping tenang, atau pendamping Bu Ratih. Bertemu Tio atau Fajar tidak membatalkan bantuan.
    voiceClip: {fileID: 0}
  choiceId: M12/route
  responses:
  - label: Lewat koridor biasa.
    lines:
    - speakerName: Sari
      text: Aku menunggumu dekat BK. Kamu boleh berhenti atau meminta pendamping kapan saja.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Pilih rute samping yang lebih tenang.
    lines:
    - speakerName: Sari
      text: Ikuti penanda jalur tenang. Laporan tetap diterima meski bertemu siapa pun.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Minta pendampingan Bu Ratih.
    lines:
    - speakerName: Bu Ratih
      text: Saya temani menuju BK dan menjaga ruang aman untuk bicara.
      voiceClip: {fileID: 0}
    retryChoices: 0
  contextChoiceId: 
  contextResponses: []
