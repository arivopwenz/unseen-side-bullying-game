  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M03_support_raka
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Narasi
    text: Alat tulis Raka jatuh di koridor.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Boleh aku membantu mengambilnya?
    voiceClip: {fileID: 0}
  choiceId: M03/support_raka
  responses:
  - label: Bantu setelah Raka mengizinkan.
    lines:
    - speakerName: Raka
      text: Boleh, terima kasih.
      voiceClip: {fileID: 0}
    - speakerName: Narasi
      text: Aji mengembalikan alat tulis kepada Raka.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Beri ruang jika Raka ingin mengambil sendiri.
    lines:
    - speakerName: Raka
      text: Aku bisa sendiri.
      voiceClip: {fileID: 0}
    - speakerName: Aji
      text: Baik, katakan jika perlu bantuan lain.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Ambil barangnya tanpa bertanya.
    lines:
    - speakerName: Narasi
      text: Meminta izin menjaga kendali Raka atas barangnya. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
