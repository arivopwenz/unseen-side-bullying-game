  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M07_listen
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Bersedia bercerita di sini?
    voiceClip: {fileID: 0}
  - speakerName: Laras
    text: Iya. Berulang kali Dion menyuruh yang lain menjauhiku. Aku sulit mendapat kelompok belajar.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku mendengar hasutannya tadi. Tidak semua siswa terlibat, tetapi pola ini perlu dihentikan.
    voiceClip: {fileID: 0}
  choiceId: M07/listen
  responses:
  - label: Bedakan ruang pribadi dari pengucilan terarah.
    lines:
    - speakerName: Aji
      text: Butuh ruang sendiri berbeda dari mengajak orang lain terus menolakmu.
      voiceClip: {fileID: 0}
    - speakerName: Laras
      text: Aku ingin tempat belajar aman.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Salahkan Laras karena kurang populer.
    lines:
    - speakerName: Narasi
      text: Kepribadian atau popularitas bukan alasan mengucilkan. Laras berhak mendapat akses belajar. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
