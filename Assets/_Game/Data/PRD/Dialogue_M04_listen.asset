MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M04_listen
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Bersedia bicara di tempat tenang?
    voiceClip: {fileID: 0}
  - speakerName: Bima
    text: Iya, tetapi aku belum ingin Sari ikut.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Baik.
    voiceClip: {fileID: 0}
  - speakerName: Bima
    text: Ejekan tubuh terjadi berulang. Aku tertawa agar cepat selesai, bukan karena nyaman. Mereka ramai-ramai, aku sulit menolak.
    voiceClip: {fileID: 0}
  choiceId: M04/listen
  responses:
  - label: Akui ketidaknyamanan Bima dan haknya dihormati.
    lines:
    - speakerName: Bima
      text: Terima kasih. Aku suka olahraga, tetapi sekarang ragu ikut tim.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Beri waktu; kembali membahas bantuan pada titik aman.
    lines:
    - speakerName: Bima
      text: Aku butuh sebentar. Setelah ini, bantu pikirkan langkah aman, ya.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Kalau tertawa, berarti setuju.
    lines:
    - speakerName: Narasi
      text: Tawa canggung dapat menjadi respons terhadap tekanan, bukan persetujuan. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
