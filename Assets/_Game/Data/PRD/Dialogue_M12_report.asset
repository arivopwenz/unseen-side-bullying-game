  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M12_report
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Pak Arif
    text: Kita bicara privat dan terpisah sesuai kesediaan, bukan memaksa semua korban bersaksi bersama.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Saya membedakan pengamatan, cerita Raka dan keterangan Sari. Beberapa rincian belum diketahui.
    voiceClip: {fileID: 0}
  - speakerName: Pak Arif
    text: Cukup untuk mulai membantu. Saya berkoordinasi dengan Bu Ratih dan Pak Beni, menghentikan tekanan, mengatur pendampingan di area rawan serta akses bantuan bila ada intimidasi.
    voiceClip: {fileID: 0}
  - speakerName: Pak Arif
    text: Saya periksa keadaan kalian beberapa hari lagi secara terpisah. Segera temui guru jika ada balasan; laporan tidak dibatalkan.
    voiceClip: {fileID: 0}
  choiceId: 
  responses: []
  contextChoiceId: 
  contextResponses: []
