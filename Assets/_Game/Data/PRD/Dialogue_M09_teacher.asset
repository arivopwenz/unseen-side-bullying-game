--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M09_teacher
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Saya mendengar Dion mengajak menolak Laras. Laras mengatakan hal itu berulang.
    voiceClip: {fileID: 0}
  - speakerName: Bu Ratih
    text: Saya memeriksa secara terpisah, menghentikan hasutan, mengatur kelompok adil, dan memantau tugas berikutnya bersama BK. Tidak ada yang dipermalukan di depan kelas.
    voiceClip: {fileID: 0}
  choiceId: M09/teacher
  responses:
  - label: Tawarkan pendampingan bila Laras ingin.
    lines:
    - speakerName: Laras
      text: Aku ingin ditemani.
      voiceClip: {fileID: 0}
    - speakerName: Bu Ratih
      text: Kita bicara privat.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Beri ruang untuk Laras berbicara sendiri.
    lines:
    - speakerName: Laras
      text: Aku memilih bicara sendiri.
      voiceClip: {fileID: 0}
    - speakerName: Bu Ratih
      text: Baik. Kamu tidak harus berteman dengan Dion untuk mendapat perlindungan.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Anggap selesai setelah satu ajakan kelompok.
    lines:
    - speakerName: Narasi
      text: Satu ajakan membantu, tetapi pola pengucilan tetap perlu dihentikan dan dipantau guru. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
