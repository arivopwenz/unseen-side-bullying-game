  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_Opening01
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Ayah Aji
    text: Selamat menjalani hari pertama. Kalau bingung, kami siap mendengar.
    voiceClip: {fileID: 0}
  - speakerName: Ibu Aji
    text: Menolong teman tidak berarti menghadapi semuanya sendirian. Kamu boleh meminta bantuan.
    voiceClip: {fileID: 0}
  - speakerName: Aji
    text: Aku ingin mengenal sekolah dan teman-teman dulu.
    voiceClip: {fileID: 0}
  - speakerName: Sari
    text: Aku Sari. Mari kenali kelas, lapangan, koridor dan BK. WASD berjalan, mouse melihat, Shift lari ringan, E berinteraksi. J jurnal, M peta, Esc jeda.
    voiceClip: {fileID: 0}
