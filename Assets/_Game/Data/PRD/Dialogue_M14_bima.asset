MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 292627ae068a3d044b459df3febbab20, type: 3}
  m_Name: Dialogue_M14_bima
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Dialogue.DialogueData
  lines:
  - speakerName: Aji
    text: Boleh menanyakan keadaanmu?
    voiceClip: {fileID: 0}
  - speakerName: Bima
    text: Boleh. Komentar berhenti, tetapi aku masih waswas.
    voiceClip: {fileID: 0}
  choiceId: M14/bima
  responses:
  - label: Dengarkan; minta guru melanjutkan pemantauan.
    lines:
    - speakerName: Pak Beni
      text: Saya mendampingi pembagian tim berikutnya dan memeriksa komentar di tepi lapangan. Pak Arif menyediakan pemeriksaan privat.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Beri ruang dan tawarkan pemeriksaan privat guru.
    lines:
    - speakerName: Bima
      text: Aku ingin bicara dengan guru saja.
      voiceClip: {fileID: 0}
    - speakerName: Pak Beni
      text: Baik. Kita atur waktu privat; kamu tetap boleh istirahat.
      voiceClip: {fileID: 0}
    retryChoices: 0
  - label: Paksa mengatakan semuanya sudah baik.
    lines:
    - speakerName: Narasi
      text: Belum nyaman bukan kegagalan korban. Dukungan dan pemantauan perlu diteruskan. Coba pilih respons lain.
      voiceClip: {fileID: 0}
    retryChoices: 1
  contextChoiceId: 
  contextResponses: []
