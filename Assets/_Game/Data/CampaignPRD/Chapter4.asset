  chapter: 4
  title: "Chapter 4 \u2022 Sisi yang Tersembunyi"
  reflection: Memahami alasan seseorang berbuat salah tidak berarti membenarkannya. Fakta, perlindungan korban, dan perubahan perilaku harus berjalan bersama.
  nextScene: Level05
  spawn: {x: 29.4, y: 0.13410038, z: 22.401014}
  steps:
  - id: L04-Q01
    title: Buka jurnal kejadian bersama Fatimah
    objective: Periksa kembali catatan kejadian yang kamu tahu
    actor: Fatimah
    pointId: L04-Q01
    insight: Bersama Fatimah, aku memeriksa mana kejadian yang kusaksikan dan mana yang kudengar dari orang lain.
    scenePath: 
    lines:
    - 'Fatimah: Ji, setelah kejadian kemarin aku mikir terus.'
    - 'Aji: Soal Bima, Radit, sama Sikka?'
    - 'Fatimah: Iya. Kita udah bantu mereka, tapi kayaknya ini pola yang berulang.'
    - 'Aji: Aku punya catatan waktunya. Tapi ada beberapa hal yang masih cuma dugaan.'
    - 'Fatimah: Berarti jangan kita tulis seolah sudah pasti.'
    - 'Aji: Benar. Kita cek sumbernya dulu, lalu bawa ke Bu Ratna.'
    - 'Fatimah: Raka kemarin kelihatan mau bilang sesuatu. Tapi jangan dipaksa di depan orang banyak.'
    - 'Aji: Aku bisa tanya baik-baik di tempat terbuka dekat guru.'
    afterLines: []
    kind: 0
    words: {fileID: 0}
    questions: []
