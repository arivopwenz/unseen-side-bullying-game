  chapter: 3
  title: "Chapter 3 \u2022 Di Balik Layar"
  reflection: Identitas dan hobi seseorang bukan alasan untuk mengejek. Dukungan yang baik menghargai pilihan, menjaga privasi, dan membantu mencari perlindungan.
  nextScene: Level04
  spawn: {x: 29.4, y: 0.13410038, z: 22.401014}
  steps:
  - id: L03-Q01
    title: Cari tahu kenapa Sikka tidak ikut klub
    objective: Temui Sikka dan tanyakan apakah ia ingin dibantu
    actor: Sikka
    pointId: L03-Q01
    insight: Aku bertanya dulu apakah Sikka ingin ditemani.
    scenePath: 
    lines:
    - 'Aji: Sik, itu sketsa kostum baru? Detailnya keren.'
    - 'Sikka: Iya, aku lagi nyoba bikin bagian lengannya sendiri.'
    - 'Laura: Harus lihat hasil jahitannya. Rapih banget!'
    - 'Aji: Kamu ikut pameran kelas, nggak?'
    - 'Sikka: Belum tahu, Ji. Aku jadi mikir dua kali.'
    - 'Aji: Kalau kamu pengin cerita, kita bisa cari tempat yang lebih tenang.'
    - 'Sikka: Boleh. Di perpustakaan aja, ya.'
    - 'Laura: Aku ikut kalau Sikka nyaman.'
    - 'Sikka: Boleh, Laur. Makasih.'
    afterLines: []
    kind: 0
    words: {fileID: 0}
    questions:
    - id: 
      text: Sikka ingin bicara di tempat tenang.
      feedback: Periksa informasi dan pilih bantuan yang aman.
      options:
      - Temani ke sudut baca dengan izin Sikka.
      - Tanya keras-keras di depan kelas.
      answer: 0
    order: []
    position: {x: 29.4, y: 0.13410038, z: 22.401014}
    quest: {fileID: 11400000, guid: e87049962695be74185ade5234e8a8af, type: 2}
