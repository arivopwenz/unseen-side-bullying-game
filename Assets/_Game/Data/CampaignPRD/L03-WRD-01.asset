  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.LevelOne.WordCardData
  puzzleId: L03-WRD-01
  title: 
  context: 
  hint: Dengarkan, hargai hak atas identitas dan hobi, lalu tawarkan bantuan dengan izin.
  feedback: Meminta korban mengubah identitas atau menyepelekan dampak tidak menyelesaikan masalah.
  response: "Sikka: \u201CMakasih, Ji. Aku mau ngomong sama Bu Ratna, tapi pelan-pelan.\u201D"
  phrases:
  - id: W1
    text: Aku denger apa yang kamu alami, Sik.
  - id: W2
    text: Kamu berhak jadi diri sendiri dan berkarya.
  - id: W3
    text: Kalau kamu mau, aku bisa temenin cari bantuan.
  - id: D1
    text: Mending kamu ubah gaya supaya nggak diejek.
  - id: D2
    text: Abaikan saja semuanya, pasti selesai sendiri.
  answer:
  - W1
  - W2
  - W3
