  - chapterId: ch1
    chapterTitle: "Bagian 1 \u2014 Bima"
    chapterDescription: Bantu Bima menemukan barang miliknya dan hadapi perundungan dengan tindakan yang tepat.
    chapterCard: {fileID: 1168986524}
    canvasGroup: {fileID: 1168986527}
    lockedOverlay: {fileID: 0}
    sceneName: Level01
