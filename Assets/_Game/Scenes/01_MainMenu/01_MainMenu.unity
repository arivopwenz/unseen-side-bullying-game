  - chapterId: prolog
    chapterTitle: "Prolog \u2014 Hari Pertama"
    chapterDescription: Mulailah perjalanan Aji sebagai murid baru dan kenali teman-temannya di SMP Harapan Bangsa.
    chapterCard: {fileID: 162468204}
    canvasGroup: {fileID: 162468207}
    lockedOverlay: {fileID: 0}
    sceneName: Tutorial
