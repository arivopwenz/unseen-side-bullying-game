  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BullyingGame.Events.ClassroomCutsceneDriver
  bima: {fileID: 463823393}
  bully1: {fileID: 108089396}
  bully2: {fileID: 1647848186}
  bimaMark: {x: -21.5, y: 0, z: 13.2}
  bully1Mark: {x: -22, y: 0, z: 13}
  bully2Mark: {x: -18, y: 0, z: 13}
  subtitleText: {fileID: 1562003407}
  lineDisplayTime: 4
  gangWaitTimeout: 15
  triggerOnce: 1
  lines:
  - '[Bel sekolah berbunyi]'
  - 'Aji: Selamat pagi, semuanya. Nama saya Aji, murid baru. Senang bertemu kalian.'
  - 'Ibu Guru: Selamat datang di kelas ini, Aji. Semoga cepat betah ya.'
  - 'Nakal: (dari pintu) Eh, anak baru sok percaya diri. Tadi aja dibuntuti si gendut.'
  - 'Nakal1: Hah, perkenalan macam apa itu. Duduk sana, jangan banyak gaya.'
  - 'Bima: (pelan) Udah, Ji... jangan diladenin.'
